# Example Rauthy secrets file for the Helm chart.
#
# secrets.toml follows the exact same layout as config.toml, but holds ONLY
# sensitive values. Every value set to "$SECRETS" in config.toml is filled from
# the matching key here at startup (file-based secrets, Rauthy 0.36+).
#
# Provide this file to the chart as `secrets.content` (inline in your values) or,
# recommended, as a Secret referenced by `secrets.existingSecret`. It is
# OPTIONAL: if you supply the secrets via env vars (HQL_SECRET_RAFT, ENC_KEYS,
# ...) or your own external Secret, you do not need this file at all.
#
# Generate strong values before use. Do NOT commit real secrets to source control.

[cluster]
# At least 16 chars each; they should differ. Generate with e.g.:
#   cat /dev/urandom | tr -dc 'a-zA-Z0-9' | head -c48
secret_raft = "CHANGE_ME_raft_secret_at_least_16_chars"
secret_api = "CHANGE_ME_api_secret_at_least_16_chars"

[encryption]
# One or more encryption keys. Format per key:
#   <key_id>/<base64 of exactly 32 random bytes>
# Generate with:
#   echo "$(openssl rand -hex 4)/$(openssl rand -base64 32)"
keys = ["CHANGEME/CHANGE_ME_base64_of_32_random_bytes_here_=="]
# The key_id from `keys` above to use for new encryptions.
key_active = "CHANGEME"
